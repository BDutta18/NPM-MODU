            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Opt the app account into the settlement ASA.\nMust be called by the provider once after deployment, before any consumer can deposit.  Issues a zero-amount self-transfer to complete the ASA opt-in.\nThe outer transaction must supply fee = 2 \u00d7 min_fee to cover the inner transaction.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "deposit",
            "args": [
                {
                    "type": "axfer",
                    "name": "payment",
                    "desc": "The ASA transfer carrying the consumer's deposit."
                },
                {
                    "type": "pay",
                    "name": "mbr_payment",
                    "desc": "A ALGO payment covering the box minimum balance requirement for first-time callers."
                }
            ],
            "returns": {
                "type": "void"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Consumer tops up their prepaid credit.\nMust be submitted as an atomic group of **three** transactions:   [0]  PaymentTransaction  \u2192 app address  (covers box MBR if new)   [1]  AssetTransferTransaction \u2192 app address  (the USDC deposit)   [2]  ApplicationCall (this method)\nFor repeat deposits the MBR is already funded; send `mbr_payment` with `amount = 0` if the box already exists.  The contract only asserts that the payment goes to the app account and the amount is non-negative.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "use_credit",
            "args": [
                {
                    "type": "address",
                    "name": "consumer",
                    "desc": "The account whose credit is debited."
                }
            ],
            "returns": {
                "type": "void"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Debit one API call from a consumer's prepaid credit.\nCalled by the facilitator (modu proxy) after it successfully forwards a paid API request.  No on-chain asset transfer occurs \u2014 this is just a box state update, making it cheap enough for high-frequency use.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "withdraw",
            "args": [],
            "returns": {
                "type": "void"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Pull accumulated earnings out as an ASA transfer.\nCaller note: set outer-transaction fee = 2 \u00d7 min_txn_fee so the inner asset transfer (fee=0) is covered by the fee pool.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "credit_balance",
            "args": [
                {
                    "type": "address",
                    "name": "consumer"
                }
            ],
            "returns": {
                "type": "uint64"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": true,
            "desc": "Return the consumer's remaining prepaid credit.\nMarked readonly so the CLI / proxy can simulate this off-chain for free (no fee, no round-trip wait for confirmation).",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "box_mbr",
            "args": [],
